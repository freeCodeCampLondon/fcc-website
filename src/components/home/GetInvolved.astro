---
import { getInvolvedHome } from "../../data/home";
import Icon from "../Icon.astro";
---

<section aria-labelledby="get-involved">
    <h2 id="get-involved" class="text-2xl font-extrabold">
        {getInvolvedHome.heading}
    </h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {getInvolvedHome.links.map((item) => (
            <li class="flex items-start gap-4 rounded-lg border border-border bg-surface p-5">
                <span class="shrink-0 rounded-md bg-bg p-2.5 text-link ring-1 ring-border">
                    <Icon name={item.icon} class="size-7" />
                </span>
                <div>
                    <h3 class="text-lg font-bold">
                        <a
                            class="inline-block py-0.5"
                            href={item.href}
                            target={item.external ? "_blank" : undefined}
                            rel={
                                item.external
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                        >
                            {item.label}
                            {item.external && (
                                <span class="sr-only">
                                    (opens in a new tab)
                                </span>
                            )}
                        </a>
                    </h3>
                    <p class="mt-1">{item.text}</p>
                </div>
            </li>
        ))}
    </ul>
</section>
