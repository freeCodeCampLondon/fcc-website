---
// The latest blog post on the home page; hidden when there are no posts.
import PostCard from "../blog/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";

const [latest] = await getPublishedPosts();
---

{latest && (
    <section aria-labelledby="from-the-blog">
        <h2 id="from-the-blog" class="text-2xl font-extrabold">
            From the blog
        </h2>
        <div class="mt-4 [&_h2]:text-xl">
            <PostCard post={latest} />
        </div>
        <a class="mt-2 inline-block py-2" href="/blog/">
            All posts
        </a>
    </section>
)}
