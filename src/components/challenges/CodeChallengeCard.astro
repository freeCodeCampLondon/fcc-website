---
import { kataUrl, type Kata } from "../../data/codewars";

interface Props {
    kata: Kata;
}

const { kata } = Astro.props;

// CodeWars colours ranks in pairs: white, yellow, blue, purple (8 to 1 kyu)
const BADGE_COLOURS: Record<number, string> = {
    8: "bg-kyu-white",
    7: "bg-kyu-white",
    6: "bg-kyu-yellow",
    5: "bg-kyu-yellow",
    4: "bg-kyu-blue",
    3: "bg-kyu-blue",
    2: "bg-kyu-purple",
    1: "bg-kyu-purple",
};
const tags = kata.tags.slice(0, 3);
---

<li
    class="flex flex-col rounded-lg border border-border bg-surface p-5"
    data-kata
    data-rank={kata.rank}
    data-tags={kata.tags.map((tag) => tag.toLowerCase()).join("|")}
>
    <h3 class="text-lg font-bold leading-snug">{kata.title}</h3>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm" aria-label="Rank and tags">
        <li
            class={`rounded-full border border-border px-2.5 py-0.5 font-bold text-kyu-text ${BADGE_COLOURS[kata.rank]}`}
        >
            {kata.rank} kyu
        </li>
        {tags.map((tag) => (
            <li class="rounded-full border border-border px-2.5 py-0.5 text-muted">
                {tag}
            </li>
        ))}
    </ul>
    <a
        class="mt-auto inline-flex min-h-11 items-center gap-1.5 self-start pt-4 font-semibold text-link underline underline-offset-4 hover:no-underline"
        href={kataUrl(kata.id)}
        target="_blank"
        rel="noopener noreferrer"
    >
        Solve on CodeWars<span class="sr-only">: {kata.title}</span>
        <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
    </a>
</li>
