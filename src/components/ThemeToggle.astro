---
// Switches between the dark default and the light theme. The choice is kept in
// localStorage under "theme"; the inline script in Layout.astro applies it
// before first paint so there is no flash of the wrong theme.
---

<button
    type="button"
    class="theme-toggle inline-flex items-center justify-center rounded-md p-2.5 text-muted hover:text-accent focus-visible:text-accent"
    aria-pressed="false"
>
    <span class="sr-only">Light theme</span>
    <svg
        class="theme-icon-moon h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
    <svg
        class="theme-icon-sun hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
</button>

<script is:inline>
    (() => {
        const root = document.documentElement;

        function render() {
            const light = root.dataset.theme === "light";
            document.querySelectorAll(".theme-toggle").forEach((button) => {
                button.setAttribute("aria-pressed", String(light));
                button
                    .querySelector(".theme-icon-sun")
                    .classList.toggle("hidden", !light);
                button
                    .querySelector(".theme-icon-moon")
                    .classList.toggle("hidden", light);
            });
        }

        document.querySelectorAll(".theme-toggle").forEach((button) => {
            if (button.dataset.bound) {
                return;
            }
            button.dataset.bound = "true";
            button.addEventListener("click", () => {
                const next = root.dataset.theme === "light" ? "dark" : "light";
                root.dataset.theme = next;
                try {
                    localStorage.setItem("theme", next);
                } catch {
                    // Storage blocked: the choice lasts for this page only
                }
                render();
            });
        });
        render();
    })();
</script>
