---
import ThemeToggle from "./ThemeToggle.astro";

interface MenuItem {
    label: string;
    href: string;
}

const menu: MenuItem[] = [
    { label: "About Us", href: "/about-us/" },
    { label: "Coding Challenges", href: "/coding-challenges/" },
    { label: "Blog", href: "/blog/" },
    { label: "Events", href: "/events/" },
];

// Highlight the section the current page belongs to (e.g. /blog/<post>/)
const current = (href: string) => Astro.url.pathname.startsWith(href);
---

<nav aria-label="Main" class="flex items-center gap-2">
    <ul class="hidden items-center gap-1 md:flex">
        {menu.map((item) => (
            <li>
                <a
                    href={item.href}
                    class="block rounded-md px-3 py-2 text-sm font-medium text-muted hover:text-accent focus-visible:text-accent aria-[current=page]:text-link"
                    aria-current={current(item.href) ? "page" : undefined}
                >
                    {item.label}
                </a>
            </li>
        ))}
    </ul>
    <ThemeToggle />
    <button
        id="menu"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-md p-2.5 text-muted hover:text-accent focus-visible:text-accent md:hidden"
    >
        <svg
            class="h-6 w-6 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path
                class="navmenu-toggle"
                fill-rule="evenodd"
                d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z"
            ></path>
            <path
                class="navmenu-toggle hidden"
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M18.278 16.864a1 1 0 0 1-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 0 1-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 0 1 1.414-1.414l4.829 4.828 4.828-4.828a1 1 0 1 1 1.414 1.414l-4.828 4.829 4.828 4.828z"
            ></path>
        </svg>
    </button>
</nav>
<nav
    id="mobile-menu"
    aria-label="Main (mobile)"
    class="navmenu-toggle hidden w-full border-t border-border py-2 md:hidden"
>
    <ul>
        {menu.map((item) => (
            <li>
                <a
                    href={item.href}
                    class="block px-1 py-3 text-base font-medium text-muted hover:text-accent focus-visible:text-accent aria-[current=page]:text-link"
                    aria-current={current(item.href) ? "page" : undefined}
                >
                    {item.label}
                </a>
            </li>
        ))}
    </ul>
</nav>
<script is:inline>
    (() => {
        const menuButton = document.getElementById("menu");

        function setOpen(open) {
            menuButton.setAttribute("aria-expanded", String(open));
            document.querySelectorAll(".navmenu-toggle").forEach((element) => {
                element.classList.toggle(
                    "hidden",
                    element.matches("path:first-child") ? open : !open,
                );
            });
        }

        menuButton.addEventListener("click", () => {
            setOpen(menuButton.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                menuButton.getAttribute("aria-expanded") === "true"
            ) {
                setOpen(false);
                menuButton.focus();
            }
        });
    })();
</script>
