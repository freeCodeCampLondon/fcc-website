---
import FAQ from "../components/faq/FAQ.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import {
    aboutFreeCodeCamp,
    getInvolved,
    intro,
    whatToExpect,
} from "../data/about";
import { pageMeta } from "../data/pageMeta";

const sectionClass = "mt-12";
const headingClass = "text-2xl font-extrabold";
---

<Layout {...pageMeta["/about-us/"]}>
    <div class="max-w-prose">
        <h1 class="text-4xl font-extrabold">About us</h1>
        {intro.map((paragraph) => (
            <p class="mt-4">{paragraph}</p>
        ))}

        <section aria-labelledby="freecodecamp-heading" class={sectionClass}>
            <h2 id="freecodecamp-heading" class={headingClass}>
                What is freeCodeCamp?
            </h2>
            {aboutFreeCodeCamp.map((paragraph) => (
                <p class="mt-4">{paragraph}</p>
            ))}
            <p class="mt-4">
                <a
                    href="https://www.freecodecamp.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Start learning on freeCodeCamp.org
                </a>
            </p>
        </section>

        <section aria-labelledby="meetup-heading" class={sectionClass}>
            <h2 id="meetup-heading" class={headingClass}>
                What happens at a meetup
            </h2>
            <p class="mt-4">
                The format varies by event, so check the
                <a href="/events/">event page</a> for what is planned. Most
                meetups include some of these:
            </p>
            <ul class="mt-4 flex flex-col gap-4">
                {whatToExpect.map((item) => (
                    <li class="rounded-lg border border-border bg-surface p-4">
                        <h3 class="text-xl font-bold">{item.title}</h3>
                        <p class="mt-1">{item.text}</p>
                    </li>
                ))}
            </ul>
            <p class="mt-4">
                Venues vary across London; each event page shows the venue and
                how to sign up.
            </p>
        </section>

        <section aria-labelledby="conduct-heading" class={sectionClass}>
            <h2 id="conduct-heading" class={headingClass}>
                Code of conduct
            </h2>
            <p class="mt-4">
                We want every meetup to be friendly, safe and welcoming for
                everyone. We follow the
                <a
                    href="https://www.freecodecamp.org/news/code-of-conduct/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    freeCodeCamp code of conduct
                </a>
                at our events and in our online spaces. If something makes you
                uncomfortable, please tell one of the organisers at the event or
                message us on Discord.
            </p>
        </section>

        <section aria-labelledby="involved-heading" class={sectionClass}>
            <h2 id="involved-heading" class={headingClass}>
                Get involved
            </h2>
            <ul class="mt-4 flex flex-col gap-4">
                {getInvolved.map((item) => (
                    <li>
                        <a
                            class="inline-flex items-center gap-2 py-1 text-lg font-bold"
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Icon name={item.icon} />
                            {item.label}
                            <span class="sr-only">(opens in a new tab)</span>
                        </a>
                        <p>{item.text}</p>
                    </li>
                ))}
            </ul>
        </section>

        <FAQ />

        <section
            id="privacy"
            aria-labelledby="privacy-heading"
            class={`${sectionClass} scroll-mt-24`}
        >
            <h2 id="privacy-heading" class={headingClass}>
                Privacy
            </h2>
            <p class="mt-4">
                This website uses Cloudflare Web Analytics to count visits and
                see which pages are useful. It does not use cookies, does not
                track you across other websites and does not collect personal
                data. We do not use any other analytics or tracking.
            </p>
            <p class="mt-4">
                See
                <a
                    href="https://www.cloudflare.com/privacypolicy/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Cloudflare's privacy policy
                </a>{" "}
                for details. Links to Discord, Luma, GitHub and freeCodeCamp
                take you to services with their own privacy policies.
            </p>
        </section>
    </div>
</Layout>
