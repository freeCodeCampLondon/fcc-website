---
import Layout from "../layouts/Layout.astro";
import { pageMeta } from "../data/pageMeta";
import JsonLd from "../components/JsonLd.astro";
import { organization } from "../lib/structuredData";
import NextEvent from "../components/NextEvent.astro";
import Hero from "../components/home/Hero.astro";
import WhatWeDo from "../components/home/WhatWeDo.astro";
import GetInvolved from "../components/home/GetInvolved.astro";
import FromTheBlog from "../components/home/FromTheBlog.astro";
---

<Layout {...pageMeta["/"]}>
    <JsonLd slot="head" data={organization} />
    <Hero />
    <div class="mt-12 flex flex-col gap-12">
        <NextEvent campaign="home" />
        <WhatWeDo />
        <FromTheBlog />
        <GetInvolved />
    </div>
</Layout>
