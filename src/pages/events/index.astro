---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { pageMeta } from "../../data/pageMeta";
import NextEvent from "../../components/NextEvent.astro";
import {
    formatEventDate,
    formatEventTimes,
    splitEvents,
    type EventData,
} from "../../lib/events";

const { next, upcoming, past } = splitEvents(
    await getCollection("events"),
    new Date(),
);
const STATUS_LABELS = { cancelled: "Cancelled", postponed: "Postponed" };
// One string per line so no stray spaces appear between the parts.
const when = (event: EventData, withTime: boolean): string =>
    [
        formatEventDate(event.start),
        withTime && formatEventTimes(event),
        event.venue?.name,
    ]
        .filter(Boolean)
        .join(", ");
---

<Layout {...pageMeta["/events/"]}>
    <h1 class="text-4xl font-extrabold">Events</h1>
    <p class="mt-4 max-w-prose">
        Our meetups are free and open to everyone, whatever your experience.
        Venues vary, so check each event for the place and time, and register on
        the event page.
    </p>

    <div class="mt-8">
        <NextEvent campaign="events" />
    </div>

    {upcoming.length > 0 && (
        <section
            class="mt-10"
            aria-labelledby="upcoming"
            data-event-list
            hidden={upcoming.every((entry) => entry === next)}
        >
            <h2 id="upcoming" class="mb-4 text-2xl font-extrabold">
                Upcoming
            </h2>
            <ul class="space-y-4">
                {upcoming.map(({ data: event }) => (
                    <li
                        class="rounded-md border border-border p-4"
                        data-upcoming-id={event.id}
                        data-event-end={event.end.toISOString()}
                        hidden={event.id === next?.id}
                    >
                        <h3 class="text-lg font-bold break-words">
                            <a href={`/events/${event.id}/`}>{event.title}</a>
                        </h3>
                        <p class="mt-1">
                            {event.status !== "scheduled" && (
                                <strong class="text-accent">
                                    {STATUS_LABELS[event.status]}:{" "}
                                </strong>
                            )}
                            {when(event, true)}
                        </p>
                    </li>
                ))}
            </ul>
        </section>
    )}

    {past.length > 0 && (
        <section class="mt-10" aria-labelledby="past-events">
            <h2 id="past-events" class="mb-4 text-2xl font-extrabold">
                Past events
            </h2>
            <p class="mb-4">
                Missed an AI workshop? Catch up with the{" "}
                <a href="/resources/ai-workshops/">AI workshop slides</a>
            </p>
            <ul class="space-y-4">
                {past.map(({ data: event }) => (
                    <li>
                        <h3 class="font-bold break-words">
                            <a
                                class="inline-block py-1"
                                href={`/events/${event.id}/`}
                            >
                                {event.title}
                            </a>
                        </h3>
                        <p class="text-muted">
                            {event.status === "cancelled" && "Cancelled: "}
                            {when(event, false)}
                        </p>
                    </li>
                ))}
            </ul>
        </section>
    )}
</Layout>
